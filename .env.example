# PairPort Configuration Example
# Copy this file to .env (or frontend/.env) for local development or production deployment.
# NEVER commit real production secrets, passwords, or persistent TURN credentials to source control.

# ==============================================================================
# Backend Configuration (FastAPI)
# ==============================================================================
PAIRPORT_ENV=development
PAIRPORT_BACKEND_HOST=127.0.0.1
PAIRPORT_BACKEND_PORT=8000
PAIRPORT_FRONTEND_ORIGIN=http://localhost:5173

# ==============================================================================
# Frontend WebRTC & ICE Configuration (Vite)
# ==============================================================================
# NOTICE ON CLIENT-SIDE ENVIRONMENT VARIABLES:
# Vite environment variables prefixed with VITE_ are embedded into the client
# bundle at build time. Anyone who opens the web app in their browser can inspect
# and extract these values via developer tools.
#
# FOR PRODUCTION TURN DEPLOYMENTS:
# Never embed permanent, shared admin credentials in client-side bundles.
# Instead, deploy an ephemeral credential service (e.g., Coturn with REST API,
# Twilio Network Traversal, Xirsys, or Cloudflare Calls) that generates short-lived,
# time-bounded credentials (e.g. valid for 1 hour) for authorized sessions.
#
# FOR LOCAL / LAB TESTING:
# You may supply your own test TURN credentials below for validation.
# ==============================================================================

# Custom API and WebSocket Base URLs (leave blank to auto-detect from window.location)
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_WS_BASE_URL=ws://127.0.0.1:8000

# STUN Servers:
# Comma-separated list of STUN URLs. STUN is lightweight, free, and used for NAT traversal.
# Default Google STUN servers will be used if left blank or omitted.
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302

# TURN Relay Servers (Optional):
# Comma-separated list of TURN/TURNS URLs. TURN relays traffic when direct P2P connections
# fail due to symmetric NATs, enterprise firewalls, or cellular network restrictions.
# Supports both 'turn:' (standard UDP/TCP) and 'turns:' (TLS encrypted).
# Example: turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
VITE_TURN_URLS=

# TURN Authentication Credentials (Required only if VITE_TURN_URLS is specified):
# If VITE_TURN_URLS is provided without credentials, PairPort will display a configuration warning.
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
