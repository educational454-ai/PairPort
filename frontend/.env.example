# PairPort Frontend Configuration Example (.env)
# Copy this file to frontend/.env for custom local frontend development.
# See root .env.example for comprehensive documentation and production security guidelines.

# STUN Servers (comma-separated list)
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302

# Optional TURN Relay Servers (comma-separated list, turn: and turns: supported)
# Example: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
VITE_TURN_URLS=

# Optional TURN Credentials (required if VITE_TURN_URLS is set)
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
